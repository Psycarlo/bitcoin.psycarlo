---
import Layout from '../layouts/layout.astro';
---

<Layout>
	<div class="pointer-events-none fixed inset-0 z-50" aria-hidden="true" style="background: repeating-linear-gradient(0deg, transparent 0px, transparent 1px, rgba(255,255,255,0.06) 1px, rgba(255,255,255,0.06) 2px);"></div>
	<div class="h-full bg-[#1a1a1a] text-white" style="font-family: 'Inter Tight', sans-serif;">
		<main class="h-full flex justify-center items-center">
			<div id="content" class="flex items-center flex-col w-full max-w-120 p-4 transition-transform duration-500 ease-in-out">
				<h1 class="text-[28px] m-0 mb-6 text-white">bitcoin-decoder</h1>
				<div class="flex w-full">
					<div class="relative flex-1">
						<input
							type="text"
							id="bitcoin-input"
							class="w-full px-4 py-3 pr-20 bg-transparent border border-[#555] rounded-none text-white text-base outline-none placeholder-[#777] focus:border-[#888]"
							placeholder="Address, Invoice, URI, ..."
						/>
						<div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1">
							<button id="network-btn" type="button" class="flex items-center bg-transparent border-none cursor-pointer p-1 text-[#777] hover:text-white transition-colors" aria-label="Select network" aria-haspopup="listbox" aria-expanded="false">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
								</svg>
							</button>
							<button id="scan-btn" type="button" class="bg-transparent border-none cursor-pointer p-1 text-[#777] hover:text-white transition-colors" aria-label="Scan QR code">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 7V5a2 2 0 0 1 2-2h2" /><path d="M17 3h2a2 2 0 0 1 2 2v2" /><path d="M21 17v2a2 2 0 0 1-2 2h-2" /><path d="M7 21H5a2 2 0 0 1-2-2v-2" /><line x1="7" y1="12" x2="17" y2="12" />
								</svg>
							</button>
						</div>
						<div id="network-menu" class="hidden absolute right-2 top-full mt-1 z-50 bg-[#1a1a1a] border border-[#555] min-w-32" role="listbox" aria-label="Network">
							<button type="button" role="option" data-network="mainnet" class="block w-full text-left px-3 py-2 text-xs text-white hover:bg-[#333] cursor-pointer">mainnet</button>
							<button type="button" role="option" data-network="testnet" class="block w-full text-left px-3 py-2 text-xs text-white hover:bg-[#333] cursor-pointer">testnet</button>
							<button type="button" role="option" data-network="signet" class="block w-full text-left px-3 py-2 text-xs text-white hover:bg-[#333] cursor-pointer">signet</button>
						</div>
					</div>
					<button id="decode-btn" type="button" class="px-5 py-3 bg-white text-[#1a1a1a] border-none rounded-none text-base cursor-pointer whitespace-nowrap hover:bg-[#e0e0e0]">Decode</button>
				</div>
				<div id="loading" class="hidden w-full mt-6 text-center text-[#777] text-sm">
					<span class="inline-block w-3 h-3 mr-2 border-2 border-[#555] border-t-white rounded-full animate-spin align-middle"></span>
					<span id="loading-text">Decoding...</span>
				</div>
				<div id="result" class="w-full mt-6 transition-opacity duration-400 ease-in-out opacity-0">
						<div id="meta"></div>
						<div id="cards-wrapper" class="relative mt-4">
							<div class="overflow-hidden">
								<div id="cards-track" class="flex transition-transform duration-500 ease-[cubic-bezier(0.25,0.1,0.25,1)]"></div>
							</div>
							<button id="arrow-left" type="button" class="hidden absolute -left-12 top-1/2 -translate-y-1/2 w-8 h-8 bg-[#1a1a1a] border border-[#555] rounded-full text-[#777] cursor-pointer hover:text-white hover:border-[#888] transition-colors z-10">&larr;</button>
							<button id="arrow-right" type="button" class="hidden absolute -right-12 top-1/2 -translate-y-1/2 w-8 h-8 bg-[#1a1a1a] border border-[#555] rounded-full text-[#777] cursor-pointer hover:text-white hover:border-[#888] transition-colors z-10">&rarr;</button>
						</div>
						<div id="dots" class="flex justify-center gap-2 mt-4"></div>
					</div>
			</div>
		</main>
	</div>
	<dialog id="scan-dialog" class="fixed inset-0 m-auto bg-[#1a1a1a] border border-[#555] rounded-lg p-0 w-full max-w-sm h-fit backdrop:bg-black/70">
		<div class="flex justify-between items-center p-4 border-b border-[#333]">
			<span class="text-white text-sm font-medium" style="font-family: 'Inter Tight', sans-serif;">Scan QR Code</span>
			<button id="scan-close" type="button" class="bg-transparent border-none text-[#777] cursor-pointer hover:text-white text-lg leading-none">&times;</button>
		</div>
		<div id="scanner" class="w-full overflow-hidden"></div>
	</dialog>
</Layout>

<script>
	import { decode } from 'bitcoin-decoder';
	import type {
		DecodedNostr,
		DecodedTransaction,
		NostrEntity,
		ProfileFetchResult,
		TransactionData,
		TransactionNetwork,
		TxInput,
		TxOutput,
	} from 'bitcoin-decoder';
	import { Html5Qrcode } from 'html5-qrcode';

	const input = document.querySelector('#bitcoin-input') as HTMLInputElement;
	const btn = document.querySelector('#decode-btn') as HTMLButtonElement;
	const result = document.querySelector('#result') as HTMLDivElement;
	const content = document.querySelector('#content') as HTMLDivElement;
	const loading = document.querySelector('#loading') as HTMLDivElement;
	const loadingText = document.querySelector('#loading-text') as HTMLSpanElement;
	const networkBtn = document.querySelector('#network-btn') as HTMLButtonElement;
	const networkMenu = document.querySelector('#network-menu') as HTMLDivElement;
	let currentNetwork: TransactionNetwork = 'mainnet';

	const updateNetworkMenu = () => {
		for (const opt of networkMenu.querySelectorAll<HTMLButtonElement>('[data-network]')) {
			const active = opt.dataset.network === currentNetwork;
			opt.classList.toggle('text-white', active);
			opt.classList.toggle('text-[#777]', !active);
		}
		networkBtn.setAttribute('aria-label', `Network: ${currentNetwork}`);
		networkBtn.title = `Network: ${currentNetwork}`;
	};

	const closeNetworkMenu = () => {
		networkMenu.classList.add('hidden');
		networkBtn.setAttribute('aria-expanded', 'false');
	};

	networkBtn.addEventListener('click', (e) => {
		e.stopPropagation();
		const open = networkMenu.classList.toggle('hidden');
		networkBtn.setAttribute('aria-expanded', open ? 'false' : 'true');
	});

	networkMenu.addEventListener('click', (e) => {
		const opt = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-network]');
		if (!opt?.dataset.network) {return;}
		currentNetwork = opt.dataset.network as TransactionNetwork;
		updateNetworkMenu();
		closeNetworkMenu();
	});

	document.addEventListener('click', (e) => {
		if (!networkMenu.contains(e.target as Node) && !networkBtn.contains(e.target as Node)) {
			closeNetworkMenu();
		}
	});

	updateNetworkMenu();

	const meta = document.querySelector('#meta') as HTMLDivElement;
	const cardsTrack = document.querySelector('#cards-track') as HTMLDivElement;
	const dots = document.querySelector('#dots') as HTMLDivElement;
	const arrowLeft = document.querySelector('#arrow-left') as HTMLButtonElement;
	const arrowRight = document.querySelector('#arrow-right') as HTMLButtonElement;

	let currentIndex = 0;
	let totalCards = 0;
	let startX = 0;
	let isDragging = false;

	const row = (label: string, text: string, extra = '', last = false) =>
		`<div class="flex justify-between py-2.5 ${last ? '' : 'border-b border-[#333]'}"><span class="text-[#777] text-sm">${label}</span><span class="text-white text-sm text-right ${extra}">${text}</span></div>`;

	const goTo = (index: number) => {
		currentIndex = ((index % totalCards) + totalCards) % totalCards;
		cardsTrack.style.transform = `translateX(-${currentIndex * 100}%)`;
		for (const [i, dot] of [...dots.children].entries()) {
			dot.classList.toggle('bg-white', i === currentIndex);
			dot.classList.toggle('bg-[#555]', i !== currentIndex);
		}
	};

	const HTML_ESCAPES: Record<string, string> = {'"':'&quot;','&':'&amp;',"'":'&#39;','<':'&lt;','>':'&gt;'};
	const escapeHtml = (text: string) =>
		text.replaceAll(/[&<>"']/g, (c) => HTML_ESCAPES[c] ?? c);

	const NOSTR_LABELS: Record<string, string> = {
		naddr: 'Nostr Address',
		nevent: 'Nostr Event',
		note: 'Nostr Note',
		nprofile: 'Nostr Profile',
		npub: 'Nostr Public Key',
		nsec: 'Nostr Private Key',
	};

	const isNostrInput = (text: string) => {
		const prefixes = ['npub1', 'nsec1', 'note1', 'nprofile1', 'nevent1', 'naddr1'];
		const lower = text.toLowerCase();
		return prefixes.some((p) => lower.startsWith(p));
	};

	const profileRows = (profile: ProfileFetchResult | undefined): string[] => {
		if (!profile || profile.status !== 'ok') {return [];}
		const p = profile.data;
		const rows: string[] = [];
		if (p.displayName || p.name) {rows.push(row('Name', p.displayName || p.name || ''));}
		if (p.nip05) {rows.push(row('NIP-05', p.nip05, 'max-w-[280px] break-all'));}
		if (p.lud16) {rows.push(row('Lightning', p.lud16, 'max-w-[280px] break-all'));}
		if (p.about) {rows.push(row('About', p.about, 'max-w-[280px] break-words'));}
		return rows;
	};

	const relaysRow = (relays: string[], last = false) => {
		if (relays.length === 0) {return '';}
		return row('Relays', relays.join(', '), 'max-w-[280px] break-all', last);
	};

	const entityRows = (entity: NostrEntity): string[] => {
		if (entity.type === 'nsec') {
			return [
				`<button type="button" class="block w-full text-left mb-3 text-[#ffb86b] text-xs border border-[#ffb86b]/40 bg-[#ffb86b]/5 rounded px-3 py-2 cursor-pointer hover:bg-[#ffb86b]/10 transition-colors" data-nsec-trigger>⚠ Private key. Never share. Click to reveal.</button>`,
				`<div class="flex justify-between py-2.5 border-b border-[#333]"><span class="text-[#777] text-sm">Hex</span><span class="text-white text-sm text-right max-w-[280px] break-all cursor-pointer select-all tracking-widest" data-nsec-reveal data-full="${escapeHtml(entity.data.hex)}">••••••••••••</span></div>`,
			];
		}
		if (entity.type === 'npub') {
			return [
				row('Hex', entity.data.hex, 'max-w-[280px] break-all'),
				...profileRows(entity.data.profile),
			];
		}
		if (entity.type === 'note') {
			return [row('Event ID', entity.data.hex, 'max-w-[280px] break-all', true)];
		}
		if (entity.type === 'nprofile') {
			return [
				row('Pubkey', entity.data.pubkey, 'max-w-[280px] break-all'),
				...profileRows(entity.data.profile),
				relaysRow(entity.data.relays, true),
			];
		}
		if (entity.type === 'nevent') {
			const rows = [row('Event ID', entity.data.id, 'max-w-[280px] break-all')];
			if (entity.data.kind !== undefined) {rows.push(row('Kind', String(entity.data.kind)));}
			if (entity.data.author) {rows.push(row('Author', entity.data.author, 'max-w-[280px] break-all'));}
			rows.push(relaysRow(entity.data.relays, true));
			return rows;
		}
		if (entity.type === 'naddr') {
			return [
				row('Identifier', entity.data.identifier, 'max-w-[280px] break-all'),
				row('Kind', String(entity.data.kind)),
				row('Author', entity.data.author, 'max-w-[280px] break-all'),
				relaysRow(entity.data.relays, true),
			];
		}
		return [];
	};

	const stripLastDivider = (rows: string[]): string[] => {
		const out = [...rows];
		for (let i = out.length - 1; i >= 0; i -= 1) {
			if (!out[i]) {continue;}
			out[i] = out[i].replace(' border-b border-[#333]', '');
			break;
		}
		return out;
	};

	const TXID_REGEX = /^[0-9a-f]{64}$/i;
	const isTxidInput = (text: string) => TXID_REGEX.test(text);

	const formatSats = (n: number) => `${n.toLocaleString('en-US')} sats`;
	const txidShort = (txid: string) => `${txid.slice(0, 8)}…${txid.slice(-8)}`;

	const inputItem = (inp: TxInput) => {
		if (inp.isCoinbase) {
			return `<div class="text-xs text-[#aaa]">Coinbase</div>`;
		}
		const prev = inp.prevout;
		const addr = prev?.address ?? prev?.scriptPubKeyType ?? '—';
		const val = prev ? formatSats(prev.value) : '';
		return `<div class="flex justify-between gap-2 text-xs"><span class="text-white break-all max-w-[200px]">${escapeHtml(addr)}</span><span class="text-[#aaa] whitespace-nowrap">${val}</span></div>`;
	};

	const outputItem = (out: TxOutput) => {
		const addr = out.address ?? out.scriptPubKeyType;
		return `<div class="flex justify-between gap-2 text-xs"><span class="text-white break-all max-w-[200px]">${escapeHtml(addr)}</span><span class="text-[#aaa] whitespace-nowrap">${formatSats(out.value)}</span></div>`;
	};

	const ioListRow = (label: string, items: string) =>
		`<div class="py-2.5 border-b border-[#333]"><div class="text-[#777] text-sm mb-2">${label}</div><div class="flex flex-col gap-1.5">${items}</div></div>`;

	const transactionDataRows = (data: TransactionData): string[] => {
		const blockSuffix = data.status.blockHeight ? ` · #${data.status.blockHeight}` : '';
		const statusText = data.status.confirmed ? `Confirmed${blockSuffix}` : 'Mempool';
		return [
			row('Status', statusText),
			row('Network', data.network),
			...(data.miner ? [row('Miner', data.miner.name)] : []),
			row('Fee', formatSats(data.fee)),
			row('Fee rate', `${data.feeRate.toFixed(2)} sat/vB`),
			row('Size', `${data.size} B · ${data.vsize} vB`),
			row('Total in', formatSats(data.totalInput)),
			row('Total out', formatSats(data.totalOutput)),
			ioListRow(`Inputs (${data.inputs.length})`, data.inputs.map(inputItem).join('')),
			ioListRow(`Outputs (${data.outputs.length})`, data.outputs.map(outputItem).join('')),
		];
	};

	const renderTransaction = (decoded: DecodedTransaction) => {
		meta.innerHTML = row('Type', 'Transaction', '', true);

		const rows = [
			row('Txid', txidShort(decoded.txid), 'cursor-pointer select-all', false),
			...(decoded.data ? transactionDataRows(decoded.data) : []),
		];

		const card = [
			`<div class="w-full shrink-0 flex-grow-0">`,
			`<div class="border border-[#333] rounded-lg p-4">`,
			`<div class="mb-3"><span class="text-[#777] text-xs uppercase tracking-wide">transaction</span></div>`,
			...stripLastDivider(rows),
			`</div></div>`,
		];
		cardsTrack.innerHTML = card.join('');

		totalCards = 1;
		currentIndex = 0;
		dots.innerHTML = '';
		arrowLeft.classList.add('hidden');
		arrowRight.classList.add('hidden');
	};

	const renderNostr = (decoded: DecodedNostr) => {
		const { entity } = decoded;
		const label = NOSTR_LABELS[entity.type] ?? entity.type;
		meta.innerHTML = row('Type', label, '', true);

		const bech32Label = entity.type.toUpperCase();
		const rows = [
			row(bech32Label, decoded.input, 'max-w-[280px] break-all'),
			...entityRows(entity),
		];

		const card = [
			`<div class="w-full shrink-0 flex-grow-0">`,
			`<div class="border border-[#333] rounded-lg p-4">`,
			`<div class="mb-3"><span class="text-[#777] text-xs uppercase tracking-wide">${entity.type}</span></div>`,
			...stripLastDivider(rows),
			`</div></div>`,
		];
		cardsTrack.innerHTML = card.join('');

		totalCards = 1;
		currentIndex = 0;
		dots.innerHTML = '';
		arrowLeft.classList.add('hidden');
		arrowRight.classList.add('hidden');
	};

	const getLoadingText = (isNostr: boolean, isTxid: boolean) => {
		if (isNostr) {return 'Fetching nostr profile...';}
		if (isTxid) {return 'Fetching transaction...';}
		return 'Decoding...';
	};

	const handleDecode = async () => {
		const inputValue = input.value.trim();
		if (!inputValue) {return;}

		const isNostr = isNostrInput(inputValue);
		const isTxid = !isNostr && isTxidInput(inputValue);
		loadingText.textContent = getLoadingText(isNostr, isTxid);
		loading.classList.remove('hidden');
		result.classList.remove('opacity-100');
		result.classList.add('opacity-0');
		content.classList.add('-translate-y-20');

		const decoded = await decode(inputValue, {
			nostr: { fetchProfile: true },
			transaction: {
				fetch: true,
				fetchMiner: true,
				network: currentNetwork,
			},
		});
		input.value = '';
		loading.classList.add('hidden');

		if (decoded.valid && decoded.kind === 'nostr') {
			renderNostr(decoded);
		} else if (decoded.valid && decoded.kind === 'transaction') {
			renderTransaction(decoded);
		} else if (decoded.valid) {
			let metaHtml = '';

			if (decoded.metadata?.amount !== undefined && decoded.metadata.amount !== null) {
				metaHtml += row('Amount', `${decoded.metadata.amount} sats`);
			}

			if (decoded.metadata?.description) {
				metaHtml += row('Description', decoded.metadata.description);
			}

			metaHtml += row('Network', decoded.network, '', true);
			meta.innerHTML = metaHtml;

			totalCards = decoded.destinations.length;
			currentIndex = 0;

			let cardsHtml = '';
			for (const [, dest] of decoded.destinations.entries()) {
				const isPrimary = dest === decoded.destination;
				const sectionLabel = totalCards > 1
					? `${dest.protocol}${isPrimary ? ' ★' : ''}`
					: dest.protocol;

				const hasAddressType = 'addressType' in dest;
				let card = `<div class="w-full shrink-0 flex-grow-0">`;
				card += `<div class="border border-[#333] rounded-lg p-4">`;
				card += `<div class="mb-3"><span class="text-[#777] text-xs uppercase tracking-wide">${sectionLabel}</span></div>`;
				card += row('Type', dest.type);
				card += row('Destination', dest.destination, 'max-w-[280px] break-all', !hasAddressType);

				if (hasAddressType) {
					card += row('Address Type', dest.addressType, '', true);
				}

				card += `</div></div>`;
				cardsHtml += card;
			}
			cardsTrack.innerHTML = cardsHtml;

			const showArrows = totalCards > 1;
			arrowLeft.classList.toggle('hidden', !showArrows);
			arrowRight.classList.toggle('hidden', !showArrows);

			let dotsHtml = '';
			if (totalCards > 1) {
				for (let i = 0; i < totalCards; i += 1) {
					dotsHtml += `<button class="w-2 h-2 rounded-full ${i === 0 ? 'bg-white' : 'bg-[#555]'} transition-colors duration-300 cursor-pointer border-none" data-index="${i}"></button>`;
				}
			}
			dots.innerHTML = dotsHtml;
		} else {
			meta.innerHTML = `<div class="text-[#ff6b6b] text-sm text-center py-2.5">${decoded.errorMessage}</div>`;
			cardsTrack.innerHTML = '';
			dots.innerHTML = '';
			arrowLeft.classList.add('hidden');
			arrowRight.classList.add('hidden');
		}

		result.classList.remove('opacity-0');
		result.classList.add('opacity-100');
	};

	const revealNsec = (hex: HTMLElement) => {
		if (hex.dataset.full) {hex.textContent = hex.dataset.full;}
		hex.classList.remove('tracking-widest');
	};

	cardsTrack.addEventListener('click', (e) => {
		const el = e.target as HTMLElement;
		const trigger = el.closest('[data-nsec-trigger]');
		if (trigger) {
			const hex = cardsTrack.querySelector('[data-nsec-reveal]') as HTMLElement | null;
			if (hex) {revealNsec(hex);}
			trigger.remove();
			return;
		}
		const target = el.closest('[data-nsec-reveal]') as HTMLElement | null;
		if (target) {revealNsec(target);}
	});

	arrowLeft.addEventListener('click', () => { goTo(currentIndex - 1); });
	arrowRight.addEventListener('click', () => { goTo(currentIndex + 1); });

	dots.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		const {index} = target.dataset;
		if (index !== undefined) {
			goTo(Number(index));
		}
	});

	cardsTrack.addEventListener('pointerdown', (e) => {
		startX = e.clientX;
		isDragging = true;
		cardsTrack.style.transition = 'none';
	});

	cardsTrack.addEventListener('pointermove', (e) => {
		if (!isDragging) {return;}
		const diff = e.clientX - startX;
		const offset = -currentIndex * 100;
		const parentWidth = cardsTrack.parentElement?.offsetWidth ?? 1;
		const pxPercent = (diff / parentWidth) * 100;
		cardsTrack.style.transform = `translateX(${offset + pxPercent}%)`;
	});

	const endDrag = (e: PointerEvent) => {
		if (!isDragging) {return;}
		isDragging = false;
		cardsTrack.style.transition = '';
		const diff = e.clientX - startX;
		const threshold = (cardsTrack.parentElement?.offsetWidth ?? 1) * 0.2;
		if (diff < -threshold) {
			goTo(currentIndex + 1);
		} else if (diff > threshold) {
			goTo(currentIndex - 1);
		} else {
			goTo(currentIndex);
		}
	};

	cardsTrack.addEventListener('pointerup', endDrag);
	cardsTrack.addEventListener('pointercancel', endDrag);

	btn.addEventListener('click', handleDecode);
	input.addEventListener('keydown', (e) => {
		if (e.key === 'Enter') {handleDecode();}
	});

	const scanBtn = document.querySelector('#scan-btn') as HTMLButtonElement;
	const scanDialog = document.querySelector('#scan-dialog') as HTMLDialogElement;
	const scanClose = document.querySelector('#scan-close') as HTMLButtonElement;

	let scanner: Html5Qrcode | null = null;

	const stopScanner = async () => {
		if (scanner) {
			try {
				await scanner.stop();
			} catch {
				// scanner already stopped
			}
			scanner.clear();
			scanner = null;
		}
	};

	scanBtn.addEventListener('click', () => {
		scanDialog.showModal();
		scanner = new Html5Qrcode('scanner');
		scanner.start(
			{ facingMode: 'environment' },
			{ aspectRatio: 1, fps: 10, qrbox: { height: 200, width: 200 } },
			async (text) => {
				input.value = text;
				scanDialog.close();
				await stopScanner();
				handleDecode();
			},
			() => {
				// scan in progress
			},
		);
	});

	const closeDialog = async () => {
		scanDialog.close();
		await stopScanner();
	};

	scanClose.addEventListener('click', closeDialog);
	scanDialog.addEventListener('click', (e) => {
		if (e.target === scanDialog) {
			closeDialog();
		}
	});
	scanDialog.addEventListener('close', () => { stopScanner(); });
</script>
